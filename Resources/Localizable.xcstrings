    "%@ depuis Hugging Face (%@). Hoova n'en garde que la partie texte, et la mascotte de la barre des menus montre l'avancement." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ from Hugging Face (%2$@). Hoova only keeps the text part, and the mascot in the menu bar shows how it's going."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ depuis Hugging Face (%2$@). Hoova n'en garde que la partie texte, et la mascotte de la barre des menus montre l'avancement."
          }
        }
      }
    },
